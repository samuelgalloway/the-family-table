# Anthropic (Claude) API — used to generate ideas and recipes
ANTHROPIC_API_KEY=
# Optional: override the model used (defaults to a current Sonnet model)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Instacart Developer Platform — used to build the shoppable link
INSTACART_API_KEY=

# Google service account — used to log recipe history to a Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
