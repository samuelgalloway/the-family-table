# Anthropic (Claude) API — used to generate ideas and recipes
ANTHROPIC_API_KEY=
# Optional: override the model used (defaults to a current Sonnet model)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional: comma-separated ingredients to always leave off the shopping
# list (defaults to a sensible list — see DEFAULT_PANTRY_STAPLES in lib/anthropic.js)
# PANTRY_STAPLES=olive oil,salt,pepper,butter

# No Instacart key needed — the shopping list links out to Instacart's
# own product search per ingredient (lib/instacart.js).

# Google service account — used to log recipe history to a Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
